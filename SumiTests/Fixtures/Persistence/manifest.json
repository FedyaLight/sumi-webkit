    {
      "id": "historical-swiftdata-50f8ff4b",
      "description": "Created once from the exact pre-VersionedSchema persistent model declarations shipped at commit 50f8ff4bea88a5d317afb7afac7e4c2966923f7b, including the removed UserScript entities, then checked in as a SQLite store family.",
      "limitations": "The historical app could not be relaunched because its archived local DDG binary dependency is absent. The fixture therefore uses the historical declarations compiled with the current SwiftData runtime, not an archived app binary. Tests never regenerate it."
    },
    {
      "id": "bookmarks-model-2",
      "description": "Created once by compiling the checked-in shipped BookmarksModel 2 model with momc and inserting a BookmarkEntity through Core Data.",
      "limitations": "Contains synthetic fixture data and no user data. Tests never regenerate it."
    },
    {
      "id": "shipped-codable-format",
      "description": "Static payload authored against the field names and enum values in a checked-in shipped Codable format at baseline 0fc8454d6; it is decoded only from disk by tests.",
      "limitations": "Synthetic minimal data; it proves wire compatibility, not every optional field combination."
    },
    {
      "id": "adversarial-format-mutation",
      "description": "Static unsupported-version, malformed, or hash-tampered mutation of a shipped-format fixture.",
      "limitations": "Designed to prove fail-closed or quarantine behavior, not successful migration."
    }
  ],
